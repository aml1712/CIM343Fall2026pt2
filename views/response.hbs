
<h1>Thank you for completing the Survey!</h1>
<h2> Find your answers below!</h2>

<p>Favorite Team: {{team}}</p>
<p>Favorite Player: {{player}}</p>






<!-- Voting display data -->
<h2>Favorite Team Vote Totals</h2>
<ul>
  {{#each teamVotes}}
    <li>{{@key}}: {{this}}</li>
  {{/each}}
</ul>

<h2>Favorite Player Vote Totals</h2>
<ul>
  {{#each playerVotes}}
    <li>{{@key}}: {{this}}</li>
  {{/each}}
</ul>



<a href="/form">Vote again</a> | <button id="clearBtn">Clear my votes</button>
<p id="message"></p>
<script>
  let clearBtn = document.getElementById("clearBtn");
  let message = document.getElementById("message");

  clearBtn.addEventListener("click", function () {
    //option 1: ignore the response, go somewhere else
        /*
        fetch("/clear", { method: "DELETE" })
        .then(function () {
            window.location.href = "/form";
        });
        */
        // Read the response and show it on this page
            fetch("/clear", { method: "DELETE" })
            .then(function (response) {
                return response.text();
            })
            .then(function (text) {
                message.innerHTML = text;
            });
  });
</script>